{
	"extends": "@refarm.dev/tsconfig/dom.json",
	"compilerOptions": {
		"noEmit": true,
		"types": ["node"],
		"outDir": "./dist-web",
		"baseUrl": "../..",
		"rootDir": "../..",
		"paths": {
			"@refarm.dev/locales/*": [
				"locales/*"
			],
			"@refarm.dev/capability-host": [
				"packages/capability-host/dist/index.d.ts"
			],
			"@refarm.dev/capability-host/node": [
				"packages/capability-host/dist/node.d.ts"
			],
			"@refarm.dev/capability-host/testing": [
				"packages/capability-host/dist/testing.d.ts"
			],
			"@refarm.dev/capability-homestead-surface": [
				"packages/capability-homestead-surface/dist/index.d.ts"
			]
		}
	},
	"exclude": [
		"node_modules",
		"dist",
		"dist-web"
	],
	"include": [
		"src/**/*",
		".astro/types.d.ts"
	]
}
