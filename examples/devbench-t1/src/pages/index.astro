---
import { FaceHub } from "@refarm.dev/homestead/ui";

// The landing HUB — a browser-safe front door that links to the bench's live faces. It replaces
// the old dashboard boot (which imported the node-bound CLI and hung on the spinner in a browser);
// the governance dashboard is now one of the linked faces (/governance), reachable and real. The
// grid + cards + hub CSS live once in FaceHub (@refarm.dev/homestead/ui); here it is just the data.
const faces = [
  {
    href: "/governance/",
    name: "Governança de extensões",
    summary:
      "O placar de viabilidade: 2 modos de política × 3 comportamentos de extensão → a decisão de risco, a partir de dados.",
  },
  {
    href: "/extension-graph/",
    name: "Grafo de extensões (SPI)",
    summary:
      "Plugin estende plugin: as arestas requiresApi → providesApi, com a recursão delegate → agent marcada como executada.",
  },
];
---

<FaceHub
  title="Bancada de Extensões — declare uma vez → em toda superfície"
  eyebrow="Bancada de extensões · T1"
  heading="Declare uma vez → em toda superfície"
  intro="A mesma declaração de verbo que dirige o CLI acende estas faces web. Cada uma roda no navegador de verdade — abra e interaja."
  faces={faces}
/>
