---
import { FaceHub } from "@refarm.dev/homestead/ui";

// The landing HUB — a browser-safe front door that links to the bench's live faces. It replaces
// the old dashboard boot (which imported the node-bound CLI and hung on the spinner in a browser).
// The grid + cards + hub CSS live once in FaceHub (@refarm.dev/homestead/ui); here it is just data.
const faces = [
  {
    href: "/search/",
    name: "Buscar requisitos",
    summary:
      "Digite um termo (ex.: CNPJ) e o mesmo verbo de busca do CLI responde na tela, com os requisitos que casam e suas facetas.",
  },
  {
    href: "/graph/",
    name: "Rede de requisitos",
    summary:
      "A rede de requisitos como grafo force-directed interativo: arraste, dê zoom, clique para focar um requisito e suas relações.",
  },
  {
    href: "/lab/",
    name: "Lab de análise",
    summary:
      "O grafo publicado como dataset de um notebook Marimo reativo (hubs, órfãos, densidade) — exportável para HTML+WASM que roda no navegador.",
  },
];
---

<FaceHub
  title="Bancada de Requisitos — declare uma vez → em toda superfície"
  eyebrow="Bancada de requisitos · T3"
  heading="Os requisitos, navegáveis"
  intro="A mesma declaração de verbo que dirige o CLI acende estas faces web. Cada uma roda no navegador de verdade — abra e interaja."
  faces={faces}
/>
