{
  "name": "reqbench-t3",
  "version": "0.0.0",
  "private": true,
  "description": "T3 POC (result mode): an analyst's requirements bench — discover a system, pull, enrich, correct, and read a navigable requirements MOC. Own CLI `reqbench`, refarm underneath.",
  "type": "module",
  "bin": {
    "reqbench": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "reqbench": "node dist/cli.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@refarm.dev/capabilities-v1": "workspace:*",
    "@refarm.dev/cli": "workspace:*",
    "@refarm.dev/enrichment-contract-v1": "workspace:*",
    "@refarm.dev/records-contract-v1": "workspace:*",
    "@refarm.dev/source-web": "workspace:*",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@refarm.dev/tsconfig": "workspace:*",
    "@refarm.dev/vtconfig": "workspace:*"
  }
}
