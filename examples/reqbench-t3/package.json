{
	"name": "reqbench-t3",
	"version": "0.0.0",
	"private": true,
	"description": "T3 POC (result mode): a DGK requirements bench — discover, enrich, correct, and read a navigable MOC.",
	"type": "module",
	"bin": {
		"dgk": "./dist/cli.js"
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"dgk": "node dist/cli.js",
		"web:dev": "astro dev",
		"web:build": "astro build",
		"web:preview": "astro preview",
		"web:check": "astro check",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@refarm.dev/browser-driver": "workspace:*",
		"@refarm.dev/capabilities": "workspace:*",
		"@refarm.dev/capability-homestead-surface": "workspace:*",
		"@refarm.dev/capability-host": "workspace:*",
		"@refarm.dev/enrichment-contract-v1": "workspace:*",
		"@refarm.dev/homestead": "workspace:*",
		"@refarm.dev/playbook": "workspace:*",
		"@refarm.dev/history-contract-v1": "workspace:*",
		"@refarm.dev/provenance-contract-v1": "workspace:*",
		"@refarm.dev/quality-contract-v1": "workspace:*",
		"@refarm.dev/records-contract-v1": "workspace:*",
		"@refarm.dev/source-web": "workspace:*",
		"@refarm.dev/artifact-contract-v1": "workspace:*",
		"@refarm.dev/lab-contract-v1": "workspace:*",
		"@refarm.dev/surveyor": "workspace:*",
		"@refarm.dev/vault-contract-v1": "workspace:*",
		"@refarm.dev/vault-surface-ref": "workspace:*"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@refarm.dev/config": "workspace:*",
		"@refarm.dev/tsconfig": "workspace:*",
		"@refarm.dev/vtconfig": "workspace:*",
		"@types/node": "catalog:",
		"astro": "^7.0.0"
	}
}
