{
  "name": "notesbox-app",
  "version": "0.0.0",
  "private": true,
	"description": "Example consuming app: declares a notesbox capability host, adds work-specific verbs, and lets refarm project every surface.",
  "type": "module",
  "bin": {
    "notesbox": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "notesbox": "node dist/cli.js",
    "clean": "rm -rf dist"
  },
	"dependencies": {
		"@refarm.dev/capabilities-v1": "workspace:*",
		"@refarm.dev/enrichment-contract-v1": "workspace:*",
		"@refarm.dev/records-contract-v1": "workspace:*",
		"@refarm.dev/source-web": "workspace:*"
	},
  "devDependencies": {
    "@refarm.dev/tsconfig": "workspace:*",
    "@refarm.dev/vtconfig": "workspace:*"
  }
}
