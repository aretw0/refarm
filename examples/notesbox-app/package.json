{
  "name": "notesbox-app",
  "version": "0.0.0",
  "private": true,
  "description": "Example consuming app: imports refarm as a white-label host, adds its own work-specific verb, mounts a CLI named `notesbox`.",
  "type": "module",
  "bin": {
    "notesbox": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "notesbox": "node dist/cli.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@refarm.dev/capabilities-v1": "workspace:*",
    "@refarm.dev/cli": "workspace:*",
    "@refarm.dev/enrichment-contract-v1": "workspace:*",
    "@refarm.dev/records-contract-v1": "workspace:*",
    "@refarm.dev/source-web": "workspace:*",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@refarm.dev/tsconfig": "workspace:*",
    "@refarm.dev/vtconfig": "workspace:*"
  }
}
