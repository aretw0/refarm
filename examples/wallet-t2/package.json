{
  "name": "wallet-t2",
  "version": "0.0.0",
  "private": true,
  "description": "T2 POC (result mode): a sovereign citizen's digital wallet — the citizen holds and reviews their own records locally. Own CLI `wallet`, refarm underneath.",
  "type": "module",
  "bin": {
    "wallet": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "wallet": "node dist/cli.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@refarm.dev/capabilities-v1": "workspace:*",
    "@refarm.dev/cli": "workspace:*",
    "@refarm.dev/enrichment-contract-v1": "workspace:*",
    "@refarm.dev/records-contract-v1": "workspace:*",
    "@refarm.dev/source-web": "workspace:*",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@refarm.dev/tsconfig": "workspace:*",
    "@refarm.dev/vtconfig": "workspace:*"
  }
}
