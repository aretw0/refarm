{
	"name": "wallet-t2",
	"version": "0.0.0",
	"private": true,
	"description": "T2 POC (result mode): a sovereign citizen's digital wallet for DGK, local-first records and review.",
	"type": "module",
	"bin": {
		"dgk": "./dist/cli.js"
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"dgk": "node dist/cli.js",
		"web:dev": "astro dev",
		"web:build": "astro build",
		"web:preview": "astro preview",
		"web:check": "astro check",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@refarm.dev/authorization-contract-v1": "workspace:*",
		"@refarm.dev/capability-homestead-surface": "workspace:*",
		"@refarm.dev/capability-host": "workspace:*",
		"@refarm.dev/credentials-contract-v1": "workspace:*",
		"@refarm.dev/enrichment-contract-v1": "workspace:*",
		"@refarm.dev/homestead": "workspace:*",
		"@refarm.dev/identity-contract-v1": "workspace:*",
		"@refarm.dev/identity-provider-ref": "workspace:*",
		"@refarm.dev/records-contract-v1": "workspace:*",
		"@refarm.dev/storage-contract-v1": "workspace:*",
		"@refarm.dev/surveyor": "workspace:*"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@refarm.dev/config": "workspace:*",
		"@refarm.dev/tsconfig": "workspace:*",
		"@refarm.dev/vtconfig": "workspace:*",
		"astro": "^7.0.0"
	}
}
