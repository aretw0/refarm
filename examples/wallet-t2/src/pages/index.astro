---
import { FaceHub } from "@refarm.dev/homestead/ui";

// The landing HUB — a browser-safe front door that links to the wallet's live faces. It replaces
// the old dashboard boot (which imported the node-bound CLI and hung on the spinner in a browser).
// The grid + cards + hub CSS live once in FaceHub (@refarm.dev/homestead/ui); here it is just data.
const faces = [
  {
    href: "/consent/",
    name: "Consentimento",
    summary:
      "O momento da decisão: um serviço pede acesso a um atributo verificado; autorize com escopo e finalidade, ou revogue — tudo ao vivo.",
  },
];
---

<FaceHub
  title="Minha Carteira Digital — consentimento soberano"
  eyebrow="Carteira do cidadão · T2"
  heading="Sua carteira, seu consentimento"
  intro="A mesma declaração de verbo que dirige o CLI acende esta face web. Ela roda no navegador de verdade — abra e interaja."
  faces={faces}
/>
