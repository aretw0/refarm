{
  "schemaVersion": 1,
  "id": "rust-plugin",
  "source": ".",
  "config": {
    "type": "plugin",
    "engine": "heartwood"
  },
  "exclude": [
    "package.json",
    "template.json",
    "turbo.json"
  ],
  "expectedFiles": [
    ".cargo/config.toml",
    "Cargo.lock",
    "Cargo.toml",
    "README.md",
    "src/lib.rs"
  ],
  "forbiddenPaths": [
    ".turbo",
    "dist",
    "node_modules",
    "package.json",
    "pkg",
    "template.json",
    "target",
    "turbo.json"
  ]
}
