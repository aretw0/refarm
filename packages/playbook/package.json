{
	"name": "@refarm.dev/playbook",
	"version": "0.1.0",
	"private": false,
	"description": "A declarative multi-step playbook: sequence capability/plugin verbs, thread each step's output into the next, dispatched through the canonical protocol.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./capability": {
			"import": "./dist/capability.js",
			"types": "./dist/capability.d.ts"
		}
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "tsc --project tsconfig.build.json --watch",
		"type-check": "tsc --noEmit",
		"type-check:dist": "tsc --project tsconfig.build.json --noEmit",
		"test": "vitest run",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@refarm.dev/capabilities-v1": "workspace:*"
	},
	"devDependencies": {
		"@refarm.dev/tsconfig": "workspace:*",
		"@refarm.dev/vtconfig": "workspace:*"
	},
	"files": [
		"dist",
		"!dist/**/*.tsbuildinfo",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"license": "MIT"
}
