{
	"name": "@refarm.dev/capability-telemetry-v1",
	"version": "0.1.0",
	"private": false,
	"description": "Shared generic skeleton for capability telemetry events (traceId/pluginId/capability/operation/durationMs/ok/errorCode) — instantiated by enrichment/identity/source/storage/sync-contract-v1",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "tsc --project tsconfig.build.json --watch",
		"lint": "eslint src",
		"type-check": "tsc --noEmit",
		"type-check:dist": "tsc --project tsconfig.build.json --noEmit",
		"clean": "rm -rf dist"
	},
	"license": "AGPL-3.0-only",
	"files": [
		"dist",
		"!dist/**/*.tsbuildinfo",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {},
	"devDependencies": {
		"@refarm.dev/eslint-config": "workspace:*",
		"@refarm.dev/tsconfig": "workspace:*",
		"typescript": "catalog:"
	}
}
