	"muted-foreground": { "$type": "color", "$value": "#6b6560" },
	"primary": { "$type": "color", "$value": "#1b5e3b" },
	"primary-foreground": { "$type": "color", "$value": "#f7f5f0" },
	"secondary": { "$type": "color", "$value": "#e0dbd2" },
