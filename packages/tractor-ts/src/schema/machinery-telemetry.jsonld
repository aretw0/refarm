{
  "@context": {
    "sovereign": "urn:sovereign:vocab#",
    "schema": "https://schema.org/",
    "MachineryTelemetry": "sovereign:MachineryTelemetry",
    "event": "sovereign:event",
    "pluginId": "sovereign:pluginId",
    "apiName": "sovereign:apiName",
    "durationMs": "sovereign:durationMs",
    "timestamp": "schema:dateCreated",
    "payload": "schema:value"
  },
  "@type": "MachineryTelemetry",
  "@id": "urn:sovereign:machinery:{timestamp}",
  "timestamp": "{ISO_DATE}",
  "event": "plugin:load | api:call | storage:io",
  "pluginId": "{PLUGIN_ID}",
  "durationMs": 0.0,
  "payload": {}
}
