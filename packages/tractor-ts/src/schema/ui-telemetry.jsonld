{
  "@context": {
    "sovereign": "urn:sovereign:vocab#",
    "schema": "https://schema.org/",
    "UITelemetry": "sovereign:UITelemetry",
    "event": "sovereign:event",
    "pluginId": "sovereign:pluginId",
    "a11yScore": "sovereign:a11yScore",
    "domPollution": "sovereign:domPollution",
    "isSeizureSafe": "sovereign:isSeizureSafe",
    "updateVelocity": "sovereign:updateVelocity",
    "timestamp": "schema:dateCreated"
  },
  "@type": "UITelemetry",
  "@id": "urn:sovereign:ui-telemetry:{timestamp}",
  "timestamp": "{ISO_DATE}",
  "event": "ui:a11y_audit | ui:performance | ui:gremlin_check",
  "pluginId": "{PLUGIN_ID}",
  "a11yScore": 1.0,
  "domPollution": 0,
  "updateVelocity": 0,
  "isSeizureSafe": true
}
