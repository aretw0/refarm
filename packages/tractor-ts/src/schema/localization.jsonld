{
  "@context": {
    "sovereign": "urn:sovereign:vocab#",
    "schema": "https://schema.org/",
    "SovereignTranslation": "sovereign:SovereignTranslation",
    "namespace": "sovereign:namespace",
    "locale": "schema:inLanguage",
    "keys": "sovereign:translationKeys",
    "timestamp": "schema:dateModified"
  },
  "@type": "SovereignTranslation",
  "@id": "urn:sovereign:l8n:{namespace}:{locale}",
  "namespace": "{plugin-id | core}",
  "locale": "{ISO-639-1}",
  "timestamp": "{ISO_DATE}",
  "keys": {
    "welcome": "Welcome to the Machine",
    "save": "Save Changes"
  }
}
