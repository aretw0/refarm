{
  "@context": {
    "sovereign": "urn:sovereign:vocab#",
    "schema": "https://schema.org/",
    "SovereignSecret": "sovereign:SovereignSecret",
    "tier": "sovereign:securityTier",
    "anchor": "sovereign:hardwareAnchor",
    "jwe": "sovereign:encryptedPayload",
    "hint": "schema:description",
    "timestamp": "schema:dateModified"
  },
  "@type": "SovereignSecret",
  "@id": "urn:sovereign:secret:{uuid}",
  "timestamp": "{ISO_DATE}",
  "tier": "gold | silver | bronze",
  "anchor": "webauthn | passkey | password | none",
  "hint": "Optional human-readable reminder of what this secret is",
  "jwe": {
    "protected": "...",
    "encrypted_key": "...",
    "iv": "...",
    "ciphertext": "...",
    "tag": "..."
  }
}
