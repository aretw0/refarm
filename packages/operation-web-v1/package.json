{
	"name": "@refarm.dev/operation-web-v1",
	"version": "0.1.0",
	"private": true,
	"description": "Browser-neutral client and localized view messages for Refarm's admitted operation catalog and bounded run lifecycle",
	"license": "MIT",
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
