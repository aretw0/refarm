package host:plugin@0.1.0;

// Host capabilities the tractor provides to plugins (plugin imports these).
//
// Part of the canonical host:plugin@0.1.0 package. WASI imports
// (wasi:http, wasi:logging) are OMITTED here because the wasmtime Linker
// registers them separately via wasmtime_wasi; bindgen! does not need Rust
// types for them, and runtime plugin binaries that import WASI still work.

// ─── Tractor → Plugin Imports (host implements) ──────────────────────────────

interface tractor-bridge {
    use types.{json-ld-node, node-id, plugin-error, identity-info};

    store-node:         func(node: json-ld-node) -> result<node-id, plugin-error>;
    get-node:           func(id: node-id) -> result<json-ld-node, plugin-error>;
    query-nodes:        func(node-type: string, limit: u32) -> result<list<json-ld-node>, plugin-error>;
    request-permission: func(capability: string, reason: string) -> bool;
    get-identity:       func() -> result<identity-info, plugin-error>;
    get-plugin-api:     func(api-name: string) -> result<node-id, plugin-error>;

    /// Call a verb on another LOADED plugin, by its id — the SPI call leg that
    /// pairs with `get-plugin-api` (discovery). A plugin that declares
    /// `requiresApi: ["FooApi"]` resolves the provider via `get-plugin-api`, then
    /// invokes a verb on it here. Routes through the SAME dispatch the agent leg's
    /// tool-call uses (`<key>:dispatch` event → correlated `dispatch-result:v1`),
    /// so there is ONE call protocol, addressed by verb, shared by both callers.
    ///
    /// SECURITY: the callee runs in ITS OWN instance under ITS OWN load-time grant
    /// + linker — never the caller's. Cross-plugin calling widens REACH, not POWER;
    /// a revoked/unloaded target is not in the registry, so the call fails honestly.
    call-plugin: func(plugin-id: node-id, verb: string, input-json: string) -> result<string, plugin-error>;

    emit-telemetry:     func(event: string, payload: option<string>);
}

/// Host-proxied model completion bridge.
///
/// Plugins pass provider + HTTP request payload and receive raw response bytes.
/// Credentials stay in the host process (plugin never reads provider API keys).
interface model-bridge {
    record stream-response-metadata {
        prompt-ref: string,
        model: string,
        provider-family: string,
        last-sequence: option<u32>,
    }

    record stream-response-result {
        final-body: list<u8>,
        last-sequence: option<u32>,
        stored-chunks: u32,
    }

    complete-http: func(
        provider: string,
        base-url: string,
        path: string,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    ) -> result<list<u8>, string>;

    complete-http-stream: func(
        provider: string,
        base-url: string,
        path: string,
        headers: list<tuple<string, string>>,
        body: list<u8>,
        stream-metadata: stream-response-metadata,
    ) -> result<stream-response-result, string>;
}

// ─── Host Effect Interfaces (host provides, plugin imports) ──────────────────
//
// These are generic host-effect capabilities — filesystem and shell syscalls
// gated per plugin by identity/config/path. Any empowered plugin (not only the
// LLM agent) uses them; the name reflects the effect boundary, not a consumer.

/// Filesystem effect primitives: read, write, edit.
/// All paths are absolute. Capability gating via TrustManager before dispatch.
interface host-fs {
    /// Read file contents from an absolute path.
    read: func(path: string) -> result<list<u8>, string>;

    /// Write bytes to a path atomically (tmp → fsync → rename).
    write: func(path: string, content: list<u8>) -> result<_, string>;

    /// Apply a unified diff string to an existing file, atomically.
    /// Returns error if the diff context does not match current file state.
    edit: func(path: string, diff: string) -> result<_, string>;
}

/// Shell effect primitive: spawn a subprocess.
/// The host never interpolates through a shell — structured argv only.
interface host-shell {
    record spawn-request {
        /// Structured argv. argv[0] is the binary name (no shell expansion).
        argv: list<string>,
        /// Environment key-value pairs to forward (explicit allowlist).
        env: list<tuple<string, string>>,
        /// Working directory (absolute path). Defaults to tractor data dir.
        cwd: option<string>,
        /// Hard timeout in milliseconds; process is killed after this.
        timeout-ms: u32,
        /// Optional stdin bytes fed into the process.
        stdin: option<list<u8>>,
    }

    record spawn-result {
        stdout: list<u8>,
        stderr: list<u8>,
        exit-code: s32,
        /// True if the process was killed due to timeout expiry.
        timed-out: bool,
    }

    /// Spawn a subprocess with structured argv (no shell interpolation).
    spawn: func(req: spawn-request) -> result<spawn-result, string>;
}

/// Structured I/O — parse and write JSON/TOML/YAML files with validation and pagination.
///
/// Defined here (host:plugin package) so any plugin can import it as a host capability.
/// The host-effects.wasm component exports the same interface under refarm:host-effects;
/// tractor satisfies the import natively until full Component Model composition
/// is wired (HANDOFF.md Tarefa 2B follow-up).
interface structured-io {
    enum file-format { json, toml, yaml }

    /// Parse a structured file and return paginated content as canonical JSON.
    /// format is auto-detected from path extension when absent.
    read-structured: func(
        path: string,
        format: option<file-format>,
        page-size: u32,
        page-offset: u32,
    ) -> result<string, string>;

    /// Validate content as format then write atomically to path.
    /// Returns error without touching the file if content fails validation.
    write-structured: func(
        path: string,
        content: string,
        format: option<file-format>,
    ) -> result<_, string>;
}

/// Registry-contributed agent tools — the AGENT LEG (#6).
///
/// A capability declared once already projects to CLI/REPL/HTTP (transports) and
/// TUI/web (renderers); this interface is the fourth invoker, the AGENT. The host
/// owns the capability registry (TS), so it lists the registry's agent-eligible
/// verbs as pre-rendered tool schemas that the guest concatenates with its built-in
/// tools at request-build time, and routes a tool CALL back to the verb's dispatch.
///
/// SECURITY: `invoke-tool` routes to a plugin verb's dispatch, which runs that
/// plugin's WASM under ITS OWN load-time grant (A/B/G) — never the agent's. So
/// surfacing a verb to the agent widens REACH, not POWER: a revoked plugin never
/// loads, its dispatch channel is never registered, and the invocation resolves to
/// an error. The guest holds no capability the host has not granted the target.
interface capability-tools {
    /// The registry's agent-eligible verbs as pre-rendered provider tool schemas
    /// (each element is a JSON object string). The guest parses and concatenates
    /// them with its built-in tool list. Provider-shaped by the host so the guest
    /// stays provider-agnostic here: the host renders anthropic- or openai-form to
    /// match the request being built. Empty list when no verb opts in.
    list-tools: func(provider: string) -> list<string>;

    /// One usage-guidance line per dispatchable verb, for the guest to append to
    /// the system prompt. Same registry + order as `list-tools`, but PROSE, not
    /// schema: it teaches the model that these tools route to plugins and how their
    /// args are shaped — under-explained by the flat tool schema alone. Provider-
    /// agnostic (prose), so no provider arg. Empty when no verb is dispatchable.
    list-tool-prompts: func() -> list<string>;

    /// Invoke a registry tool by its model-facing name with a JSON input object.
    /// The host routes to the verb's dispatch (an Effort to the target plugin's
    /// WASM) and returns the result as a JSON string, or an error string. This is
    /// the two-phase dispatch made synchronous to the guest: the host awaits the
    /// dispatch-result correlation before returning.
    invoke-tool: func(name: string, input-json: string) -> result<string, string>;
}

/// Semantic code operations via LSP (rename, find-references).
///
/// Host manages the LSP server subprocess; plugin calls clean primitives without
/// knowing whether the backend is rust-analyzer, typescript-language-server, etc.
/// Tractor exposes these operations through its generic LSP bridge; concrete
/// backend readiness remains a host concern.
interface code-ops {
    /// Location of a symbol in source code.
    record symbol-location {
        file:   string,
        line:   u32,
        column: u32,
    }

    /// A reference to a symbol found by LSP.
    record code-reference {
        file:   string,
        line:   u32,
        column: u32,
        /// "definition" | "reference" | "implementation"
        kind:   string,
    }

    /// Summary of a rename operation.
    record rename-result {
        files-changed: u32,
        edits-applied: u32,
    }

    /// Rename symbol at loc across the entire project (LSP workspace/rename).
    rename-symbol: func(loc: symbol-location, new-name: string) -> result<rename-result, string>;

    /// Find all references to symbol at loc (LSP textDocument/references).
    find-references: func(loc: symbol-location) -> result<list<code-reference>, string>;
}
