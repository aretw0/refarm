{
	"name": "@refarm.dev/storage-node-view",
	"version": "0.1.0",
	"description": "Record⇄node adapter — lets any StorageProvider serve as a node graph. A ledger record IS a serialized node. Ships openScopedLedger, the host bootstrap for durable node-ledgers.",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/aretw0/refarm.git",
		"directory": "packages/storage-node-view"
	},
	"bugs": {
		"url": "https://github.com/aretw0/refarm/issues"
	},
	"homepage": "https://refarm.dev",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"keywords": [
		"storage",
		"node",
		"ledger",
		"json-ld",
		"local-first"
	],
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "tsc --project tsconfig.build.json --watch",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"clean": "rm -rf dist",
		"lint": "eslint src"
	},
	"dependencies": {
		"@refarm.dev/node-contract-v1": "workspace:*",
		"@refarm.dev/storage-contract-v1": "workspace:*",
		"@refarm.dev/storage-fs": "workspace:*"
	},
	"devDependencies": {
		"@refarm.dev/tsconfig": "workspace:*",
		"typescript": "catalog:",
		"@refarm.dev/vtconfig": "workspace:*",
		"@refarm.dev/eslint-config": "workspace:*"
	}
}
