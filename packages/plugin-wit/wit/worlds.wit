package plugin:host@0.1.0;

// The worlds of the canonical plugin:host@0.1.0 package.
//
// Every world exports the SAME `integration` interface (one interface for all
// plugins — see integration.wit). Worlds differ only in which host
// capabilities the plugin imports and which optional interfaces it also
// exports. A plugin picks the smallest world that covers what it needs.

// ─── Plugin-side worlds (a plugin builds against one of these) ───────────────

/// Base plugin: exports integration, imports only the data bridge.
/// Simple plugins (templates, bridges) target this. They still implement all
/// of `integration`; unused funcs (e.g. respond) return a trivial stub.
world plugin {
    import tractor-bridge;
    export integration;
}

/// The effect-capable world: base + full host-effect capabilities (fs, shell,
/// structured-io, code-ops) plus the model bridge. The LLM agent guest targets
/// this world today; any empowered plugin needing host effects can too. Still
/// exports the same `integration` (the agent implements respond for real;
/// others stub it).
world effect-capable {
    import tractor-bridge;
    import model-bridge;
    import host-fs;
    import host-shell;
    import structured-io;
    import code-ops;
    import capability-tools;
    import host-connection;
    export integration;
}

/// A plugin that also serves as an identity provider.
world identity-plugin {
    include plugin;
    export identity-provider;
}

/// A plugin that also serves HTTP requests.
world http-plugin {
    include plugin;
    export http-handler;
}

// ─── Host-side world (tractor-native bindgen! targets this) ──────────────────

/// The world the tractor host generates bindings for. Imports every host
/// capability (so the host can implement them for plugins) and exports
/// `integration` (so the host can call into any loaded plugin). Named
/// `host-plugin` (not `plugin-host`) so the bindgen! type is `HostPlugin`,
/// which does not collide with the host's own `PluginHost` struct.
world host-plugin {
    import tractor-bridge;
    import model-bridge;
    import host-fs;
    import host-shell;
    import structured-io;
    import code-ops;
    import capability-tools;
    import host-connection;
    export integration;
}
