			"@refarm.dev/enrichment-contract-v1": [
				"packages/enrichment-contract-v1/dist/index.d.ts"
			],
			"@refarm.dev/effort-contract-v1": [
				"packages/effort-contract-v1/dist/index.d.ts"
			],
