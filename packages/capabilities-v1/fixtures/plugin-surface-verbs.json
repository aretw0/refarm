{
	"schema": "plugin-surface-verbs.conformance.v1",
	"manifests": [
		{
			"id": "@local/notes",
			"capabilities": {
				"verbs": {
					"list": {
						"lookup": {
							"doc": "Look up a note by title.",
							"schema": { "type": "object", "properties": { "title": { "type": "string" } } }
						},
						"index": {},
						"find": {
							"doc": "Find notes by text.",
							"args": [
								{ "name": "query", "type": "string", "required": true },
								{ "name": "limit", "type": "integer" },
								{ "name": "kind", "type": "string", "enum": ["note", "task"] },
								{ "name": "tags", "type": "array" }
							]
						},
						"merge": {
							"schema": { "type": "object", "properties": { "ids": { "type": "array", "items": { "type": "string" } } } },
							"args": [{ "name": "ignored", "type": "string" }]
						},
						"locate": {
							"doc": "Locate a symbol.",
							"args": [
								{ "name": "file", "type": "string", "required": true },
								{ "name": "line", "type": "integer", "required": true },
								{ "name": "column", "type": "integer", "required": true },
								{ "name": "target_file", "type": "string", "required": true }
							]
						}
					}
				}
			}
		},
		{
			"id": "@local/orphan",
			"capabilities": {
				"provides": ["orphan:search"],
				"subscribes": ["other:dispatch"]
			}
		},
		{
			"id": "@local/vault",
			"capabilities": {
				"provides": [
					"vault:search",
					"vault:extract",
					"vault:dispatch",
					"bad",
					":leading",
					"trailing:"
				],
				"subscribes": ["vault:dispatch"],
				"verbDocs": {
					"vault:search": "Search the vault for notes matching a query."
				},
				"verbSchemas": {
					"vault:search": {
						"type": "object",
						"properties": { "query": { "type": "string" } },
						"required": ["query"]
					}
				}
			}
		},
		{
			"id": "@local/web",
			"capabilities": {
				"provides": ["web:search"],
				"subscribes": ["web:dispatch"]
			}
		}
	],
	"expected": [
