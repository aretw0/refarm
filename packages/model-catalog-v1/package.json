{
  "name": "@refarm.dev/model-catalog-v1",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical model pricing catalog contract and resolver",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json",
    "./catalog/model-rates.v1.json": "./catalog/model-rates.v1.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "type-check:dist": "tsc --project tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/index.test.ts",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist",
    "README.md",
    "catalog"
  ],
  "devDependencies": {
    "@refarm.dev/eslint-config": "workspace:*",
    "@refarm.dev/tsconfig": "workspace:*",
    "@refarm.dev/vtconfig": "workspace:*"
  }
}
