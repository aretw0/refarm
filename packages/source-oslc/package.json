{
	"name": "@refarm.dev/source-oslc",
	"version": "0.1.0",
	"private": false,
	"description": "Generic OSLC / IBM Jazz (ELM, DOORS-Next, EWM) read toolkit for the source:v1 capability — protocol only, no vendor vocabulary.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "tsc --project tsconfig.build.json --watch",
		"lint": "eslint src",
		"type-check": "tsc --noEmit",
		"type-check:dist": "tsc --project tsconfig.build.json --noEmit",
		"test": "vitest run",
		"test:unit": "vitest run src/oslc.test.ts",
		"test:conformance": "vitest run src/oslc.test.ts",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@refarm.dev/source-contract-v1": "workspace:*",
		"@refarm.dev/source-web": "workspace:*"
	},
	"devDependencies": {
		"@refarm.dev/eslint-config": "workspace:*",
		"@refarm.dev/tsconfig": "workspace:*",
		"@refarm.dev/vtconfig": "workspace:*"
	},
	"files": [
		"dist",
		"!dist/**/*.tsbuildinfo",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"license": "MIT"
}
