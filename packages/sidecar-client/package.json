{
	"name": "@refarm.dev/sidecar-client",
	"version": "0.1.0",
	"description": "Sidecar client — HTTP transport for reaching host sidecars.",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "tsc --project tsconfig.build.json --watch",
		"type-check": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit",
		"test": "vitest run",
		"lint": "eslint src"
	},
	"license": "AGPL-3.0-only",
	"files": [
		"dist/index.js",
		"dist/index.d.ts"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@refarm.dev/node-contract-v1": "workspace:*",
		"@refarm.dev/pressure-contract-v1": "workspace:*",
		"@refarm.dev/root": "workspace:*"
	},
	"devDependencies": {
		"@refarm.dev/eslint-config": "workspace:*",
		"@refarm.dev/tsconfig": "workspace:*",
		"@refarm.dev/vtconfig": "workspace:*"
	}
}
