{
	"name": "@refarm.dev/std",
	"version": "0.1.0",
	"description": "Zero-dependency pure primitives shared across the substrate — slugify, hashing, small text/id utils",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./node": {
			"import": "./dist/node.js",
			"types": "./dist/node.d.ts"
		}
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "tsc --project tsconfig.build.json --watch",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"clean": "rm -rf dist",
		"lint": "eslint src"
	},
	"license": "AGPL-3.0-only",
	"files": [
		"dist",
		"!dist/**/*.tsbuildinfo",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {},
	"devDependencies": {
		"@refarm.dev/tsconfig": "workspace:*",
		"typescript": "catalog:",
		"@refarm.dev/vtconfig": "workspace:*",
		"@refarm.dev/eslint-config": "workspace:*"
	}
}
