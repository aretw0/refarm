{
	"name": "@refarm.dev/lab-contract-v1",
	"version": "0.1.0",
	"description": "Lab notebook + dataset catalogs → an artifact manifest (Marimo→WASM export, provenance)",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "tsc --project tsconfig.build.json --watch",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"clean": "rm -rf dist",
		"lint": "eslint src"
	},
	"license": "AGPL-3.0-only",
	"files": [
		"dist",
		"!dist/**/*.tsbuildinfo",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@refarm.dev/artifact-contract-v1": "workspace:*",
		"@refarm.dev/process-handoff": "workspace:*"
	},
	"devDependencies": {
		"@refarm.dev/tsconfig": "workspace:*",
		"typescript": "catalog:",
		"@refarm.dev/vtconfig": "workspace:*",
		"@refarm.dev/eslint-config": "workspace:*"
	}
}
