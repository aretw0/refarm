{
	"extends": [
		"../../tsconfig.json",
		"@refarm.dev/tsconfig/buildable.json"
	],
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		"baseUrl": "../..",
		"paths": {
			"@refarm.dev/capabilities-v1": [
				"packages/capabilities-v1/dist/index.d.ts"
			],
			"@refarm.dev/capabilities-v1/node": [
				"packages/capabilities-v1/dist/node.d.ts"
			],
			"@refarm.dev/records-contract-v1": [
				"packages/records-contract-v1/dist/index.d.ts"
			],
			"@refarm.dev/runtime-operator": [
				"packages/runtime-operator/dist/index.d.ts"
			]
		}
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}
