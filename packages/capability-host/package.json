{
	"name": "@refarm.dev/capability-host",
	"version": "0.1.0",
	"description": "White-label capability host boundary for Refarm-compatible apps and examples.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./node": {
			"import": "./dist/node.js",
			"types": "./dist/node.d.ts"
		}
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "tsc --project tsconfig.build.json --watch",
		"lint": "eslint src",
		"type-check": "tsc --noEmit",
		"type-check:dist": "tsc --project tsconfig.build.json --noEmit",
		"test": "vitest run",
		"clean": "rm -rf dist"
	},
	"keywords": [
		"capability-host",
		"white-label",
		"surface",
		"refarm"
	],
	"license": "MIT",
	"files": [
		"dist",
		"!dist/**/*.tsbuildinfo",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@refarm.dev/capabilities-v1": "workspace:*"
	},
	"devDependencies": {
		"@refarm.dev/eslint-config": "workspace:*",
		"@refarm.dev/tsconfig": "workspace:*",
		"@refarm.dev/vtconfig": "workspace:*"
	}
}
