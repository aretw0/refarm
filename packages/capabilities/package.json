{
	"name": "@refarm.dev/capabilities",
	"version": "0.1.0",
	"description": "The Refarm capability model — CapabilityDescriptor/Registry, the open surface-projection axis (ADR-085), and the neutral projectors (cli/http/agent/openapi/palette). The one declaration many surfaces project from.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./envelope": {
			"types": "./dist/envelope.d.ts",
			"import": "./dist/envelope.js"
		}
	},
	"files": [
		"README.md",
		"dist",
		"!dist/**/*.tsbuildinfo"
	],
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "tsc --project tsconfig.build.json --watch",
		"lint": "eslint src",
		"type-check": "tsc --noEmit",
		"test": "vitest run"
	},
	"keywords": [
		"refarm",
		"capability",
		"surface",
		"projection",
		"registry"
	],
	"dependencies": {
		"chalk": "^5.6.2",
		"commander": "^14.0.3"
	},
	"license": "AGPL-3.0-only",
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@refarm.dev/eslint-config": "workspace:*",
		"@refarm.dev/operator-state": "workspace:*",
		"@refarm.dev/tsconfig": "workspace:*",
		"@refarm.dev/vtconfig": "workspace:*"
	}
}
