#!/usr/bin/env node

export function run{{pascalName}}Probe() {
	return {
		schemaVersion: 1,
		validation: "{{name}}",
		ok: true,
		summary: "{{description}}",
		substrate: "host",
	};
}

if (import.meta.url === `file://${process.argv[1]}`) {
	console.log(JSON.stringify(run{{pascalName}}Probe(), null, 2));
}
