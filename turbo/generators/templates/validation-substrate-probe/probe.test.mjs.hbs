#!/usr/bin/env node
import assert from "node:assert/strict";
import { readFileSync } from "node:fs";
import test from "node:test";

import { run{{pascalName}}Probe } from "./run-probe.mjs";

test("{{name}} probe matches expected evidence", () => {
	const expected = JSON.parse(
		readFileSync(new URL("./evidence/probe-current.json", import.meta.url), "utf8"),
	);
	assert.deepEqual(run{{pascalName}}Probe(), expected);
});
