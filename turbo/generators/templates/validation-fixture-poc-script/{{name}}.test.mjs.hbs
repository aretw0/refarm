#!/usr/bin/env node
import assert from "node:assert/strict";
import { readFileSync } from "node:fs";
import test from "node:test";

import { build{{pascalName}}EvidencePacket } from "./{{name}}.mjs";

function readExpectedJson(name) {
	return JSON.parse(
		readFileSync(new URL(`./fixtures/expected/${name}`, import.meta.url), "utf8"),
	);
}

test("{{name}} emits the expected validation evidence packet", () => {
	const actual = build{{pascalName}}EvidencePacket();

	assert.deepEqual(actual.scorecard, readExpectedJson("scorecard.json"));
	assert.deepEqual(actual.taskArtifacts, readExpectedJson("task-artifacts.json"));
	assert.match(
		readFileSync(new URL("./fixtures/expected/scenario.md", import.meta.url), "utf8"),
		/{{name}}/,
	);
});
