#!/usr/bin/env node
import {
	createLocalCapabilityDeps,
	createPluginDescriptorDeps,
	defineCapabilityApp,
	defineCapabilityHost,
	type CapabilityHost,
	type SubmitEffort,
} from "@refarm.dev/capability-host";
import { createSidecarSubmitEffort } from "@refarm.dev/capability-host/node";

import {
	{{constantName}}_MANIFEST,
	create{{pascalName}}Capability,
} from "./persona.js";

export const {{constantName}}_SIDECAR_URL_ENV = "{{constantName}}_SIDECAR_URL";
export const {{constantName}}_DEFAULT_SIDECAR_URL = "http://127.0.0.1:{{runtimeSidecarPort}}";

export interface {{pascalName}}HostOptions {
	submitEffort?: SubmitEffort;
}

export function build{{pascalName}}Host(options: {{pascalName}}HostOptions = {}): CapabilityHost {
	const pluginDeps = createPluginDescriptorDeps({
		submitEffort: options.submitEffort ?? createSidecarSubmitEffort({
			baseUrl: {{constantName}}_DEFAULT_SIDECAR_URL,
			envKey: {{constantName}}_SIDECAR_URL_ENV,
		}),
	});

	return defineCapabilityHost({
		id: "examples/{{name}}",
		command: "{{commandName}}",
		description: "{{description}}",
		version: "0.0.0",
		capabilities: {
			deps: createLocalCapabilityDeps(),
			manifests: [{{constantName}}_MANIFEST],
			pluginDeps,
			extensions: [create{{pascalName}}Capability(pluginDeps)],
		},
		operatorStatus: {
			summary: "Show {{personaTitle}} operator status",
			httpPath: "/{{personaVerb}}/status",
			capabilityUnit: {
				subject: "{{personaTitle}}",
				action: {
					id: "open-{{personaVerb}}",
					label: "{{commandName}} {{personaVerb}} --json",
					intent: "{{personaVerb}}:inspect",
					command: "{{commandName}} {{personaVerb}} --json",
					primary: true,
				},
			},
		},
		serve: {
			defaultPort: {{defaultPort}},
			description: "Serve {{personaTitle}} verbs over HTTP",
		},
	});
}

const {{camelName}}App = defineCapabilityApp({
	host: build{{pascalName}}Host,
});

export const buildRegistry = {{camelName}}App.registry;
export const buildProgram = {{camelName}}App.program;

void {{camelName}}App.runCli(import.meta.url, {
	compiledFileName: "cli.js",
});
