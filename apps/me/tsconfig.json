{
	"extends": "@refarm.dev/tsconfig/dom.json",
	"compilerOptions": {
		"noEmit": true,
		"outDir": "./dist",
		"baseUrl": ".",
		"rootDir": "../..",
		"paths": {
			"@refarm.dev/locales/*": [
				"../../locales/*"
			],
			"@refarm.dev/tractor/browser": [
				"../../packages/tractor-ts/src/index.browser.ts"
			]
		}
	},
	"exclude": [
		"node_modules",
		"dist"
	],
	"include": [
		"src/**/*",
		".astro/types.d.ts"
	]
}
