{
	"extends": "@refarm.dev/tsconfig/dom.json",
	"compilerOptions": {
		"noEmit": true,
		"outDir": "./dist",
		"baseUrl": ".",
		"rootDir": "../..",
		"paths": {
			"@refarm.dev/locales/*": [
				"../../locales/*"
			]
		}
	},
	"exclude": [
		"node_modules",
		"dist"
	],
	"include": [
		"src/**/*",
		".astro/types.d.ts"
	],
	"references": [
		{
			"path": "../../packages/identity-contract-v1/tsconfig.build.json"
		},
		{
			"path": "../../packages/storage-contract-v1/tsconfig.build.json"
		},
		{
			"path": "../../packages/sync-contract-v1/tsconfig.build.json"
		}
	]
}
