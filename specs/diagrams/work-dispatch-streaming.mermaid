flowchart LR
  subgraph Surfaces["Operator Surfaces"]
    CLI["refarm CLI"]
    Channels["channel integrations"]
    Clients["SDK / PWA clients"]
  end

  Effort["effort-contract-v1\nEffort · Task · TaskResult"]

  subgraph CliAdapters["apps/refarm — private client adapters"]
    Dispatch["dispatch-surface\nselection · paths · channel capability"]
    FileClient["FileTransportClient"]
    HttpClient["HttpTransportClient"]
    ChannelClient["HttpChannelTransportClient"]
  end

  subgraph Ingress["Farmhand Ingress"]
    TaskFiles["tasks/*.json\nnode-local queue"]
    Http["HttpSidecar :42001\n/efforts · /channels/:id/efforts"]
    Operations["EffortOperations\ntransport-neutral boundary"]
    FileAdapter["FileTransportAdapter\nfile/control watcher + compatibility facade"]
    FileRepository["FileEffortRepository\nJSON / NDJSON wire formats"]
    FileState["task-results/*.json\ntask-logs/*.ndjson"]
  end

  Queue["EffortQueue\nserial · de-duplicate · force promotion"]
  ExecutionState["EffortExecutionState\nin-flight + cancellation requests"]
  RepositoryPort["EffortRepository\ntransport-neutral persistence port"]
  Coordinator["EffortCoordinator\nsubmit · retry · cancel · telemetry"]
  Processor["EffortProcessor\nattempts · transitions · lifecycle logs"]
  SummaryPolicy["effort-summary\npure status + window policy"]
  Remaining["remaining work\nHTTP client stays app-private\nparity proof is pending"]

  Executor["Farmhand task executor\npolicy · model route · plugin call"]
  Runtime["runtime host → agent plugin"]
  Chunk["stream-contract-v1\nStreamChunk"]
  Registry["StreamRegistry\nproject and dispatch"]

  subgraph StreamTransports["Stream Transports"]
    FileStream["FileStreamTransport\nstreams/*.ndjson · replay"]
    SSE["SseStreamTransport\nGET /stream/:ref"]
    WS["WsStreamTransport\nWS /ws/stream"]
  end

  Follower["stream-follower\nfile poll or SSE source"]
  WsConsumer["WebSocket consumer"]

  CLI --> Dispatch
  Channels --> Dispatch
  Clients --> Dispatch
  Dispatch --> Effort
  Effort -->|"file"| FileClient
  Effort -->|"http"| HttpClient
  Effort -->|"channel:*"| ChannelClient
  FileClient -->|"writes"| TaskFiles
  HttpClient -->|"HTTP /efforts"| Http
  ChannelClient -->|"HTTP /channels/:id/efforts"| Http
  TaskFiles -->|"watched by"| FileAdapter
  Http -->|"depends on"| Operations
  Coordinator -.->|"implements"| Operations
  FileAdapter -->|"constructs"| FileRepository
  FileAdapter -->|"delegates to"| Coordinator
  Remaining -.-> Coordinator
  FileRepository -.->|"implements"| RepositoryPort
  FileRepository -->|"reads definitions"| TaskFiles
  FileRepository -->|"writes state"| FileState
  Coordinator -->|"aggregates through"| SummaryPolicy
  Coordinator -->|"schedules through"| Queue
  Coordinator -->|"composes"| Processor
  Queue -->|"serial callback"| Processor
  Coordinator -->|"controls"| ExecutionState
  Processor -->|"reads / updates"| ExecutionState
  Processor -->|"persists through"| RepositoryPort
  Processor --> Executor
  Executor --> Runtime
  Runtime -->|"StreamChunk node"| Chunk
  Chunk --> Registry
  Registry --> FileStream
  Registry --> SSE
  Registry --> WS
  FileStream --> Follower
  SSE --> Follower
  WS --> WsConsumer
  Follower --> CLI
  Follower --> Clients

  classDef surface fill:#dbeafe,stroke:#1d4ed8,stroke-width:1px;
  classDef contract fill:#ede9fe,stroke:#5b21b6,stroke-width:1px;
  classDef runtime fill:#dcfce7,stroke:#166534,stroke-width:1px;
  classDef transport fill:#e0f2fe,stroke:#075985,stroke-width:1px;

  class CLI,Channels,Clients,Follower,WsConsumer surface;
  class Effort,Operations,RepositoryPort,SummaryPolicy,Chunk contract;
  class Queue,ExecutionState,Coordinator,Processor,Executor,Runtime,Registry runtime;
  class Dispatch,FileClient,HttpClient,ChannelClient,TaskFiles,Http,FileAdapter,FileRepository,FileState,FileStream,SSE,WS,Remaining transport;
